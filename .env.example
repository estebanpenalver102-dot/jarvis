# Copy to .env and fill in values
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=      # optional — free Kimi/Hermes/Llama fallback
GROQ_API_KEY=            # optional — free fast Llama inference
OLLAMA_BASE_URL=http://host.docker.internal:11434  # optional — local models
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
