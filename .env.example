# Copy to .env and fill in values
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret
POSTGRES_DB=jarvis_db
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret@postgres:5432/jarvis_db

# LLM Providers (add the one you use)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# LiveKit (for voice)
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# App
APP_ENV=development
LOG_LEVEL=INFO
